# Copy to .env for local development. On Replit, set these in Tools -> Secrets.
# See docs/oauth-setup.md for where each value comes from.

# MySQL 8: mysql://user:password@host:3306/database. Hosted servers usually need encryption: add ?ssl-mode=REQUIRED
# or set DATABASE_SSL=true (DATABASE_SSL=verify also checks the certificate; DATABASE_SSL_CA holds a custom CA as PEM text).
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_CA=
# Connections the API keeps open at most (default 10).
DATABASE_POOL_SIZE=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=
OAUTH_REDIRECT_BASE_URL=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
FACEBOOK_GRAPH_API_VERSION=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_ENABLED=
# Format YYYYMM. Required for organization accounts, and also turns on real
# thumbnail images on LinkedIn link-card posts. See the comment in .env.
LINKEDIN_API_VERSION=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: requests per window before /auth/login and /auth/signup return
# 429. Defaults: 20 per 15 minutes, 10 per hour.
AUTH_LOGIN_RATE_LIMIT=
AUTH_SIGNUP_RATE_LIMIT=

# Optional publishing scheduler settings. Defaults: check every 15000 ms; a post
# more than 60 minutes past its time is marked failed instead of sent late.
PUBLISH_POLL_INTERVAL_MS=
PUBLISH_MISSED_GRACE_MINUTES=
# Set to true to stop this process from publishing (e.g. a second instance).
PUBLISHER_DISABLED=

# Optional media upload settings (defaults shown). Files are stored on local disk.
MEDIA_STORAGE_DIR=
MEDIA_MAX_IMAGE_BYTES=
MEDIA_MAX_VIDEO_BYTES=
MEDIA_MAX_FILES_PER_POST=
MEDIA_WORKSPACE_QUOTA_BYTES=
MEDIA_ORPHAN_MAX_AGE_HOURS=
# YouTube uploads: private (default), unlisted or public. Google forces private until the API project is audited.
YOUTUBE_DEFAULT_PRIVACY=
# Set to true only after adding the first-comment permissions to each developer app (see docs/publishing-features.md).
COMMENT_SCOPES_ENABLED=

# Email, used for "Forgot password" links. Without it the forgot-password form tells the
# user that email isn't set up. Any SMTP account works (Gmail app password, Resend, SendGrid, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Socialflow <no-reply@yourdomain.com>"
# Local development only: print emails to the server log instead of sending them.
# MAIL_TRANSPORT=log

PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ---- Team, analytics, inbox, AI (all optional) --------------------------------
# Ask each network for the extra permissions analytics/inbox need (needs app review on Meta; reconnect accounts after enabling).
# ANALYTICS_SCOPES_ENABLED=true
# COMMENT_SCOPES_ENABLED=true
# ANALYTICS_POLL_HOURS=6
# ANALYTICS_DISABLED=true
# INBOX_POLL_MINUTES=10
# INBOX_DISABLED=true
# AI Studio: without a key the page says it isn't configured; nothing is ever generated locally.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5
# AI_DAILY_LIMIT=100

# ---- Automations: WordPress auto-share and RSS feeds (all optional) -----------
# How often each kind of source is checked. Defaults: WordPress every 15 minutes, RSS every 60.
# WORDPRESS_POLL_MINUTES=15
# RSS_POLL_MINUTES=60
# Set to true to stop this process from running automations (e.g. a second instance).
# AUTOMATIONS_DISABLED=true

# ---- WordPress plugin (optional) ----------------------------------------------
# New posts SocialFlow takes from one site in an hour (a bulk publish can't flood the accounts). Default 30.
# WORDPRESS_PLUGIN_POSTS_PER_HOUR=30
# Requests the plugin endpoints take from one address in 10 minutes. Default 600.
# WORDPRESS_PLUGIN_RATE_LIMIT=600
# The connection key carries the address the plugin calls. It is OAUTH_REDIRECT_BASE_URL, unless the key is made while
# using SocialFlow at this installation's own host or at localhost (development), in which case it is that address.
# Whichever it is must be reachable from the WordPress site.
