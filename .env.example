# Copy this file to .env (same folder) and fill it in. The API reads .env when it starts; restart it after a change.
# On a host (Render, Replit...) set the same names in its environment or secrets page instead of using a file.
# Never commit .env. Values left empty below must be filled in where marked REQUIRED; the rest are optional.
# Where each social network's values come from: README.md and docs/oauth-setup.md.

# ---- Required -----------------------------------------------------------------
# REQUIRED. MySQL 8: mysql://user:password@host:3306/database. Hosted servers usually need encryption: add
# ?ssl-mode=REQUIRED or set DATABASE_SSL=true (DATABASE_SSL=verify also checks the certificate; DATABASE_SSL_CA holds
# a custom CA as PEM text). The tables are created when the API starts, or with: pnpm --filter @workspace/scripts run migrate
DATABASE_URL=mysql://socialflow:change-me@127.0.0.1:3306/socialflow
DATABASE_SSL=
DATABASE_SSL_CA=
# Connections the API keeps open at most (default 10).
DATABASE_POOL_SIZE=

# REQUIRED. Signs the session cookie. Any long random text:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# REQUIRED to connect social accounts. Encrypts their stored tokens: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a backup. If it is lost, every connected account has to be connected again.
TOKEN_ENCRYPTION_KEY=
# Only while changing the key: the old key, used for reading until every token has been re-saved.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# REQUIRED. The address people open the site at, without a trailing slash. Sign-in callbacks, password-reset links
# and the allowed CORS origin all come from it. Must be https, except http://localhost for development
# (Instagram refuses http even then: use a tunnel, see README "Troubleshooting").
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# REQUIRED. The port the API listens on. In development the site (port 3000) forwards /api to port 5000;
# if you change this, start the site with API_PROXY_TARGET=http://localhost:<port>.
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ---- Social networks (each one is optional; a network without its values shows "Setup required") ---------------
# Meta: Facebook Pages (Meta app -> App settings -> Basic)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Only for "Facebook Login for Business": the configuration that lists the permissions.
FACEBOOK_LOGIN_CONFIG_ID=
# Default v26.0.
FACEBOOK_GRAPH_API_VERSION=

# Meta: Instagram (the Instagram product's "API setup with Instagram login" page; not the Facebook app's ID and secret)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# LinkedIn (linkedin.com/developers -> your app -> Auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# true also offers the company Pages the member administers (needs LinkedIn's Community Management API access).
LINKEDIN_ORG_ENABLED=
# Format YYYYMM. Required for company Pages, and also turns on real thumbnail images on LinkedIn link-card posts.
LINKEDIN_API_VERSION=

# Google / YouTube (console.cloud.google.com -> Credentials -> OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YouTube uploads: private (default), unlisted or public. Google forces private until the API project is audited.
YOUTUBE_DEFAULT_PRIVACY=

# X (Twitter): the OAuth 2.0 Client ID and Client Secret of your app in the X developer console
# (docs/twitter-setup.md). X has no free plan: posting uses credits bought in that console.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# X charges for every read, so follower and post numbers are only collected from X when this is true.
TWITTER_ANALYTICS_ENABLED=

# Extra permissions. Each is only asked for at sign-in when its switch is true, because a network refuses a sign-in
# that asks for a permission the developer app doesn't have. Reconnect the accounts after turning one on.
# First comments (docs/publishing-features.md):
COMMENT_SCOPES_ENABLED=
# Reach and impressions (needs app review on Meta):
# ANALYTICS_SCOPES_ENABLED=true
# Direct messages and mentions in the inbox (needs app review on Meta):
# MESSAGING_SCOPES_ENABLED=true

# ---- Email (optional; needed for "Forgot password" and emailed reports) ---------------------------------------
# Without it the forgot-password form says email isn't set up. Any SMTP account works (Gmail app password, Resend,
# SendGrid, Mailgun, Brevo...). Some hosts block ports 25, 465 and 587 on their free plans: use a provider that
# offers another port (often 2525).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Socialflow <no-reply@yourdomain.com>"
# Local development only: print emails to the server log instead of sending them.
# MAIL_TRANSPORT=log

# ---- Publishing scheduler (optional) ---------------------------------------------------------------------------
# Defaults: check every 15000 ms; a post more than 60 minutes past its time is marked failed instead of sent late.
PUBLISH_POLL_INTERVAL_MS=
PUBLISH_MISSED_GRACE_MINUTES=
# Set to true to stop this process from publishing (e.g. a second instance).
PUBLISHER_DISABLED=
# How often an Instagram video is checked while Instagram processes it. Default 3000 ms.
# INSTAGRAM_POLL_INTERVAL_MS=3000

# ---- Media uploads (optional; defaults shown in docs/media.md) -------------------------------------------------
# Files are stored on local disk, by default in backend/api-server/.data/media. On a host, point this at a disk
# that survives restarts.
MEDIA_STORAGE_DIR=
MEDIA_MAX_IMAGE_BYTES=
MEDIA_MAX_VIDEO_BYTES=
MEDIA_MAX_FILES_PER_POST=
MEDIA_WORKSPACE_QUOTA_BYTES=
MEDIA_ORPHAN_MAX_AGE_HOURS=

# ---- Team, analytics, inbox, reports, AI (all optional) --------------------------------------------------------
# ANALYTICS_POLL_HOURS=6
# ANALYTICS_DISABLED=true
# INBOX_POLL_MINUTES=10
# INBOX_DISABLED=true
# Emailed reports: how often due reports are looked for (default 5 minutes).
# REPORTS_POLL_MINUTES=5
# REPORTS_DISABLED=true
# AI Studio: without a key the page says it isn't configured; nothing is ever generated locally.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5
# AI_DAILY_LIMIT=100

# ---- Automations: WordPress auto-share and RSS feeds (all optional) --------------------------------------------
# How often each kind of source is checked. Defaults: WordPress every 15 minutes, RSS every 60.
# WORDPRESS_POLL_MINUTES=15
# RSS_POLL_MINUTES=60
# Set to true to stop this process from running automations (e.g. a second instance).
# AUTOMATIONS_DISABLED=true

# ---- WordPress plugin (optional) -------------------------------------------------------------------------------
# New posts SocialFlow takes from one site in an hour (a bulk publish can't flood the accounts). Default 30.
# WORDPRESS_PLUGIN_POSTS_PER_HOUR=30
# Requests the plugin endpoints take from one address in 10 minutes. Default 600.
# WORDPRESS_PLUGIN_RATE_LIMIT=600
# The connection key carries the address the plugin calls. It is OAUTH_REDIRECT_BASE_URL, unless the key is made while
# using SocialFlow at this installation's own host or at localhost (development), in which case it is that address.
# Whichever it is must be reachable from the WordPress site.

# ---- Request limits per address (all optional; defaults shown) -------------------------------------------------
# Sign-in 20 per 15 minutes, sign-up 10 per hour, forgot-password 10 per hour, reset attempts 20 per hour.
AUTH_LOGIN_RATE_LIMIT=
AUTH_SIGNUP_RATE_LIMIT=
# AUTH_FORGOT_RATE_LIMIT=10
# AUTH_RESET_RATE_LIMIT=20
# Team invitations, per hour:
# TEAM_INVITE_RATE_LIMIT=30
# Media uploads, per 15 minutes:
# MEDIA_UPLOAD_RATE_LIMIT=300
# Link previews and AI requests, per minute:
# LINK_PREVIEW_RATE_LIMIT=30
# AI_RATE_LIMIT=20
# "Refresh now" for analytics and the inbox, and "Send now" for reports, per 5 minutes:
# ANALYTICS_REFRESH_RATE_LIMIT=5
# INBOX_REFRESH_RATE_LIMIT=5
# REPORTS_SEND_RATE_LIMIT=5
# Automations ("Run now", "Test source") and CSV imports (preview, import), per 10 minutes:
# AUTOMATION_RUN_RATE_LIMIT=10
# AUTOMATION_TEST_RATE_LIMIT=30
# BULK_IMPORT_PREVIEW_RATE_LIMIT=60
# BULK_IMPORT_RATE_LIMIT=10

# ---- Not read from this file ------------------------------------------------------------------------------------
# The site's dev server (Vite) takes its settings from the shell, not from .env:
#   VITE_PORT (or CLIENT_PORT)   the port the site is served on in development (default 3000)
#   API_PROXY_TARGET             where it forwards /api (default http://localhost:5000)
#   BASE_PATH                    the path the site is served under (default /)
# The one-time PostgreSQL -> MySQL copy (docs/mysql.md) takes SOURCE_DATABASE_URL and SOURCE_DATABASE_SSL on its
# command line. REPLIT_DEV_DOMAIN, REPLIT_DOMAINS and REPL_ID are set by Replit itself when the project runs there.
