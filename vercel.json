{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/socialflow run build",
  "outputDirectory": "artifacts/socialflow/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://socialflow-api-n3e0.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
